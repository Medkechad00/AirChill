      "name": "Validate status request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Check strictly. Reject unexpected statuses and session identifiers.\nconst b = $input.first().json.body || {};\nconst id = typeof b.session_id === 'string' ? b.session_id.trim() : '';\nconst status = typeof b.status === 'string' ? b.status : '';\nconst permitted = ['Pending staff review','In progress','Completed'];\nconst valid = /^[a-zA-Z0-9_-]{1,128}$/.test(id) && permitted.includes(status);\nreturn [{ json: valid ? { valid: true, session_id: id, status, updated_at: new Date().toISOString() } : { valid: false, error: 'Invalid session_id or status' } }];"
      }
    },
    {
      "id": "c09ebc2c-f684-5110-82d1-a019dbdeefef",
      "name": "Valid request?",
      "type": "n8n-nodes-base.if",
