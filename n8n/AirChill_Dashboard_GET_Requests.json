      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Google Sheets emits one item per row. Empty sheet => []\nconst rows = $input.all().map(item => item.json).filter(row =>\n  row && typeof row.session_id === 'string' && row.session_id.trim().length > 0\n);\nreturn [{ json: { items: rows, count: rows.length, source: 'google_sheets' } }];"
      }
