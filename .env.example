# Set DEMO_MODE=false ONLY after you have published and configured both n8n webhooks.
DEMO_MODE=true

# Set these for LIVE mode; never use webhook-test URLs.
N8N_GET_REQUESTS_URL=https://YOUR-SUBDOMAIN.app.n8n.cloud/webhook/airchill-demo-requests
N8N_UPDATE_STATUS_URL=https://YOUR-SUBDOMAIN.app.n8n.cloud/webhook/airchill-demo-status

# Same SECRET VALUE is configured as the webhook Header Auth credential in both n8n workflows.
# Both n8n credentials must have header name x-airchill-key.
N8N_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Required in LIVE mode. Password protects access to the staff dashboard.
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
